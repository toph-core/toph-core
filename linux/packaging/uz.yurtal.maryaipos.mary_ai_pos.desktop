[Desktop Entry]
Type=Application
Name=Mary AI POS
Comment=Mary AI point-of-sale terminal
Exec=mary_ai_pos
Icon=uz.yurtal.maryaipos.mary_ai_pos
Terminal=false
Categories=Office;Finance;
